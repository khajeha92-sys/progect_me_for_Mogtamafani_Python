#IN THE NAME OF GOD
#Mean absolute deviation (MAD) is the averageof how much the individual
# scores of a data set differ from the mean of the set.
#  (The mean of the deviations from the mean.)

def s(data):
    sum_data = sum(data)
    len_data = len(data)
    m = sum_data / len_data

    total = 0
    for i in data:
        p = i - m
        #total += p**2


    #g = total / (len_data - 1)
    g = total / len_data
    return g

def standard_divetion():
    h = s(data)
    p = h ** 0.5
    #v = round(p, 2)
    return p #v

def varians():
    cv = s(data) / standard_divetion() * 100
    return cv

### Driver Code ###
data = [35, 30, 32, 29, 27, 37, 41]
print(f'{s(data)}')
print(f'{standard_divetion()}')
print(f'{varians()}')
